# Copiez ce fichier en .env puis renseignez les valeurs.

# Chaîne de connexion MongoDB (Atlas ou locale), avec le nom de la base.
MONGO_URI=mongodb+srv://utilisateur:motdepasse@cluster.example.mongodb.net/telecoms

# Secret de signature des sessions (au moins 32 caractères).
# Générer : openssl rand -hex 32
JWT_SECRET=

# Mots de passe des comptes de démonstration créés par `npm run seed` (facultatif).
# SEED_ADMIN_PASSWORD=
# SEED_OPERATOR_PASSWORD=

# --- Phase 3 : entraînement sur Kaggle (appelé directement par Next.js) ---
# Pseudo Kaggle (obligatoire) et jeton : Kaggle → Settings → API → Create New Token.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
# Ancienne clé (kaggle.json) acceptée à la place du jeton :
# KAGGLE_KEY=
# GPU Kaggle (compte avec téléphone vérifié). Le petit MLP s'entraîne très bien sur CPU.
# KAGGLE_ENABLE_GPU=false
# KAGGLE_DATASET_SLUG=telecom-satisfaction-madagascar
# KAGGLE_KERNEL_SLUG=telecom-satisfaction-training
# TRAINING_TIMEOUT_MINUTES=90

# --- Veille réseaux sociaux (espace opérateur → Veille & e-réputation) ---
# Uniquement des données réelles. Sans clé, une source est désactivée (aucune simulation).
# Avis App Store et presse en ligne (Google Actualités) fonctionnent sans clé.
# Facebook, X et TikTok interdisent le scraping : seules leurs API officielles sont utilisées.
# YouTube Data API v3 (gratuit) : console.cloud.google.com → API → YouTube Data API v3 → Clé API
# YOUTUBE_API_KEY=
# X API v2 (offre payante « Basic » minimum pour la recherche) :
# X_BEARER_TOKEN=
# Page Facebook officielle de l'opérateur (jeton de page, permission pages_read_engagement) :
# FACEBOOK_PAGE_ID_YAS=
# FACEBOOK_PAGE_TOKEN_YAS=
# FACEBOOK_PAGE_ID_ORANGE=
# FACEBOOK_PAGE_TOKEN_ORANGE=
# FACEBOOK_PAGE_ID_AIRTEL=
# FACEBOOK_PAGE_TOKEN_AIRTEL=
